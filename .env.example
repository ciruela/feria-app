# Copiá este archivo a .env y completá con tus credenciales de Supabase.
# Settings → API en https://supabase.com/dashboard

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Solo para scripts de admin (ej. upload de fotos). Nunca en la app cliente.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (emails de auth vía SMTP Supabase). Solo para scripts de deploy, no en la app.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@armenext.com
# RESEND_SENDER_NAME=Armenext
